{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "ADMIN_EMAIL",
    "ADMIN_NAME",
    "ADMIN_PASSWORD",
    "APP_ORIGINS",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "DATABASE_SSL",
    "DATABASE_URL",
    "DEMO_PASSWORD",
    "EMAIL_WORKER_CONCURRENCY",
    "EMAIL_WORKER_RATE_LIMIT_DURATION_MS",
    "EMAIL_WORKER_RATE_LIMIT_MAX",
    "EVENT_WORKER_CONCURRENCY",
    "NOTIFICATION_WORKER_CONCURRENCY",
    "OPENAI_API_KEY",
    "NODE_ENV",
    "RATE_LIMIT_AUTH_MAX",
    "RATE_LIMIT_AUTH_WINDOW_MS",
    "RATE_LIMIT_CONTACT_MAX",
    "RATE_LIMIT_CONTACT_WINDOW_MS",
    "REDIS_URL",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "S3_ACCESS_KEY_ID",
    "S3_BUCKET",
    "S3_ENDPOINT",
    "S3_FORCE_PATH_STYLE",
    "S3_PUBLIC_ENDPOINT",
    "S3_REGION",
    "S3_SECRET_ACCESS_KEY",
    "TRUSTED_PROXY_HEADERS",
    "VITE_API_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".output/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
